#include <unistd.h>
#include <fcntl.h>
#include <sys/types.h>
#include <sys/stat.h>
#include <stdio.h>

int main() {
    int fd;
    const char *text = "Hello from write() system call in C!\n";

    fd = open("output.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (fd < 0) {
        perror("File open failed");
        return 1;
    }

    ssize_t bytes_written = write(fd, text, 37);

    if (bytes_written < 0) {
        perror("Write failed");
        close(fd);
        return 1;
    }

    printf("Successfully written %ld bytes to output.txt\n",
           bytes_written);

    close(fd);
    return 0;
}
