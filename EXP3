// SJF Scheduling (Non-preemptive)
void sjf(struct Process p[], int n) {
 struct Process temp;
 // Sort based on burst time
 for (int i = 0; i < n-1; i++)
 for (int j = i+1; j < n; j++)
 if (p[j].burst < p[i].burst) {
 temp = p[i]; p[i] = p[j]; p[j] = temp;
 }
 p[0].waiting = 0;
 for (int i = 1; i < n; i++)
 p[i].waiting = p[i - 1].waiting + p[i - 1].burst;
 for (int i = 0; i < n; i++)
 p[i].turnaround = p[i].waiting + p[i].burst;
}
// Priority Scheduling (Non-preemptive, lower value = higher 
priority)
void priority(struct Process p[], int n) {
 struct Process temp;
 // Sort based on priority
 for (int i = 0; i < n-1; i++)
 for (int j = i+1; j < n; j++)
 if (p[j].priority < p[i].priority) {
 temp = p[i]; p[i] = p[j]; p[j] = temp;
 }
 p[0].waiting = 0;
 for (int i = 1; i < n; i++)
 p[i].waiting = p[i - 1].waiting + p[i - 1].burst;
 for (int i = 0; i < n; i++)
 p[i].turnaround = p[i].waiting + p[i].burst;
}
